PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/d2c
TEST_DATABASE_URL=postgres://user:password@localhost:5432/d2c_test
# Required in production/dev — real tokens are verified against this project's JWKS endpoint.
SUPABASE_URL=https://your-project-ref.supabase.co
# Only used by the test suite (test/helpers/test-jwt.ts signs HS256 tokens with this secret).
# Not used to verify real Supabase Auth tokens — those use SUPABASE_URL's JWKS endpoint above.
SUPABASE_JWT_SECRET=replace-with-supabase-project-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
# Signs the OAuth "state" parameter (separate from SUPABASE_JWT_SECRET — different
# purpose, different blast radius if either leaks).
STATE_SIGNING_SECRET=replace-with-a-long-random-string
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-hex-key
# Comma-separated list of allowed frontend origins for CORS. Omit to allow any origin
# (fine for local dev with no cookies involved); set explicitly in production.
CORS_ORIGIN=https://your-frontend-domain.com
SHOPIFY_API_KEY=replace-with-shopify-app-api-key
SHOPIFY_API_SECRET=replace-with-shopify-app-api-secret
# The backend's own public base URL — used to build the OAuth redirect_uri.
PUBLIC_API_URL=https://d2c.probild.in
# The frontend's own public base URL — used to build the post-OAuth redirect back to the app.
FRONTEND_URL=https://d2c.probild.in
# Meta (Facebook) app credentials — from developers.facebook.com, used for the Meta Ads
# OAuth connect flow (ads_read scope only, no ads_management).
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
# Optional. Facebook Login for Business Configuration ID — only needed if you've
# deliberately created one (Meta App Dashboard > Facebook Login for Business >
# Configurations) to bundle a specific permission set for a public-facing login flow.
# Leave unset to use the classic scope-based OAuth dialog instead (ads_read), which works
# immediately for any user added as an Admin/Developer/Tester on the app, no Configuration
# or App Review required.
META_LOGIN_CONFIG_ID=
# Google Ads API credentials. GOOGLE_ADS_CLIENT_ID/SECRET come from a Google Cloud OAuth
# 2.0 Client ID (Web application type). GOOGLE_ADS_DEVELOPER_TOKEN comes from a Google Ads
# manager account's API Center (requires basic/standard access approval from Google, a
# separate process from the OAuth client itself).
GOOGLE_ADS_CLIENT_ID=replace-with-your-oauth-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=replace-with-your-oauth-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=replace-with-your-developer-token
# Optional. Shiprocket's webhook system supports an `x-api-key` header you choose when
# registering the webhook in their dashboard (Settings > API > Webhooks, Growth plan and
# above) — set the same value here to have it checked. Leave unset to skip that check (the
# webhook URL's connectionId, an unguessable UUID, is the baseline safeguard either way).
# The webhook URL itself is PUBLIC_API_URL + /api/webhooks/shiprocket/<connectionId>/orders.
SHIPROCKET_WEBHOOK_API_KEY=
# Delhivery's webhook isn't self-service — register it via your Delhivery account manager
# (their own docs note 5-6 business days turnaround), giving them:
# PUBLIC_API_URL + /api/webhooks/delhivery/<connectionId>/orders
# Delhivery's webhook system has no documented signature mechanism at all; the connectionId
# in the URL is the only safeguard.
# Razorpay — razorpay.com dashboard → Settings → API Keys (key id/secret) and
# Settings → Webhooks (webhook secret, after registering
# PUBLIC_API_URL + /api/webhooks/razorpay with the subscription.charged,
# subscription.halted, and subscription.cancelled events).
RAZORPAY_KEY_ID=replace-with-your-key-id
RAZORPAY_KEY_SECRET=replace-with-your-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret
# Create one recurring monthly Plan per self-serve tier in Razorpay's dashboard
# (Settings > Plans) matching plans.monthly_fee_inr for small/medium/large —
# Enterprise has no Razorpay Plan, it's Contact Us only — then paste each Plan's id here.
RAZORPAY_PLAN_ID_SMALL=replace-with-plan-id
RAZORPAY_PLAN_ID_MEDIUM=replace-with-plan-id
RAZORPAY_PLAN_ID_LARGE=replace-with-plan-id
